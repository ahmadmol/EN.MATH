  "objectives": [
    {
      "ar": "أحسب الجذر الرئيسي وأميز بينه وبين حل معادلة تربيعية.",
      "en": "Compute the principal root and distinguish it from solving a squared equation."
    },
    {
      "ar": "أبسّط الجذور وأجمع الحدود المتشابهة وأنطق مقامًا بسيطًا ضمن الشروط.",
      "en": "Simplify radicals, combine like terms and rationalize a simple denominator within the domain."
    }
  ],
  "prerequisites": [
    {
      "ar": "المربعات والضرب والكسور وتوزيع الضرب.",
      "en": "Squares, multiplication, fractions and distributivity."
    }
  ],
  "sections": [
    {
      "kind": "explanation",
      "title": {
        "ar": "الجذر الرئيسي غير سالب",
        "en": "The principal root is nonnegative"
      },
      "body": {
        "ar": "جذر عدد غير سالب هو العدد غير السالب الذي مربعه يساوي ذلك العدد. إشارة الجذر تعطي قيمة واحدة؛ حل معادلة يكون مربع المجهول فيها عددًا موجبًا يعطي حلين متعاكسين.",
        "en": "The principal root is the nonnegative number whose square is the radicand. A radical denotes one value; a squared-unknown equation with positive right side has two opposite solutions."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "definition",
      "title": {
        "ar": "المجال والإشارة",
        "en": "Domain and sign"
      },
      "body": {
        "ar": "لا يوجد جذر تربيعي حقيقي لعدد سالب. جذر الصفر صفر. عند تربيع عدد سالب ثم أخذ جذره لا نعيد الإشارة السالبة؛ نحصل على قيمته المطلقة.",
        "en": "Negative numbers have no real square root. The root of zero is zero. Squaring a negative then taking the root gives its absolute value, not the negative input."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "formula",
      "title": {
        "ar": "قواعد الجذر",
        "en": "Root identities"
      },
      "body": {
        "ar": "نستعمل قاعدة الجداء والقسمة مع أعداد غير سالبة. لا توجد قاعدة مماثلة لتوزيع الجذر على جمع عددين.",
        "en": "Product and quotient identities hold on the nonnegative domain. A square root does not distribute over addition."
      },
      "math": "(√a)^2 = a; √(x^2) = |x|; √(ab) = √a × √b; √(a/b) = √a/√b",
      "conditions": [
        {
          "ar": "a,b ≥ 0 في الجداء؛ a ≥ 0 وb > 0 في القسمة؛ x عدد حقيقي.",
          "en": "a,b ≥ 0 for products; a ≥ 0 and b > 0 for quotients; x real."
        }
      ]
    },
    {
      "kind": "explanation",
      "title": {
        "ar": "أخرج المربع الكامل",
        "en": "Extract a square factor"
      },
      "body": {
        "ar": "حلل العدد تحت الجذر إلى مربع كامل مضروب في عدد لا يحتوي عاملًا مربعًا أكبر من واحد. اجمع معاملات الجذور ذات الجزء الجذري نفسه فقط.",
        "en": "Factor out a perfect square, leaving a squarefree radicand. Combine coefficients only when the remaining radical parts agree."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "formula",
      "title": {
        "ar": "مقام دون جذر",
        "en": "Rationalize a denominator"
      },
      "body": {
        "ar": "اضرب البسط والمقام في الجذر نفسه؛ هذا ضرب في واحد ولا يغير القيمة. لا يجوز أن يكون المقام صفرًا.",
        "en": "Multiply both numerator and denominator by the same root: multiplying by one preserves the value. The denominator must not be zero."
      },
      "math": "c/√b = c√b/b",
      "conditions": [
        {
          "ar": "b > 0؛ والمقام الأصلي غير صفر.",
          "en": "b > 0; original denominator nonzero."
        }
      ]
    },
    {
      "kind": "summary",
      "title": {
        "ar": "ثلاثة فحوص",
        "en": "Three checks"
      },
      "body": {
        "ar": "افحص المجال والإشارة أولًا، ثم استخرج المربعات الكاملة، ثم اجمع المتشابه فقط. أبقِ الجواب دقيقًا ولا تستبدل الجذر بتقريب إلا إذا طُلب ذلك.",
        "en": "Check domain and sign, extract square factors, then combine like terms only. Keep exact answers unless an approximation is requested."
      },
      "math": "",
      "conditions": []
    }
  ],
  "examples": [
    {
      "id": "root-e1",
      "prompt": {
        "ar": "بسّط √45.",
        "en": "Simplify √45."
      },
      "verification": {
        "operation": "radical",
        "radicand": 45
      },
      "verifiedResult": [
        "3",
        5
      ],
      "steps": [
        {
          "math": "45 = 9 × 5",
          "reason": {
            "ar": "نستخرج أكبر مربع كامل.",
            "en": "Extract the largest square factor."
          }
        },
        {
          "math": "√45 = 3√5",
          "reason": {
            "ar": "الخمسة لا تحوي عاملًا مربعًا أكبر من واحد.",
            "en": "Five has no nontrivial square factor."
          }
        }
      ],
      "check": {
        "expression": "3**2*5",
        "expected": "45"
      },
      "sourcePages": {
        "fromPdf": 16,
        "toPdf": 21
      }
    },
    {
      "id": "root-e2",
      "prompt": {
        "ar": "احسب جذر مربع عدد سالب.",
        "en": "Compute the root of a negative number squared."
      },
      "verification": {
        "operation": "sqrt_square",
        "value": -6
      },
      "verifiedResult": "6",
      "steps": [
        {
          "math": "(-6)^2 = 36",
          "reason": {
            "ar": "التربيع يعطي عددًا موجبًا.",
            "en": "Squaring gives a positive value."
          }
        },
        {
          "math": "√36 = 6",
          "reason": {
            "ar": "الجذر الرئيسي غير سالب؛ ليس سالب ستة.",
            "en": "The principal root is nonnegative, not negative six."
          }
        }
      ],
      "check": {
        "expression": "6**2",
        "expected": "36"
      },
      "sourcePages": {
        "fromPdf": 16,
        "toPdf": 21
      }
    },
    {
      "id": "root-e3",
      "prompt": {
        "ar": "اجمع √12 و√27.",
        "en": "Add √12 and √27."
      },
      "verification": {
        "operation": "combine_radicals",
        "left": 12,
        "right": 27,
        "rightSign": 1
      },
      "verifiedResult": [
        "5",
        3
      ],
      "steps": [
        {
          "math": "√12 = 2√3; √27 = 3√3",
          "reason": {
            "ar": "نبسّط الحدين أولًا.",
            "en": "Simplify each term first."
          }
        },
        {
          "math": "2√3 + 3√3 = 5√3",
          "reason": {
            "ar": "الجزء الجذري نفسه؛ نجمع المعاملين.",
            "en": "The radical parts agree, so add coefficients."
          }
        }
      ],
      "check": {
        "expression": "2+3",
        "expected": "5"
      },
      "sourcePages": {
        "fromPdf": 16,
        "toPdf": 21
      }
    },
    {
      "id": "root-e4",
      "prompt": {
        "ar": "أنطق مقام 6/√3.",
        "en": "Rationalize 6/√3."
      },
      "verification": {
        "operation": "rationalize",
        "numerator": 6,
        "radicand": 3
      },
      "verifiedResult": [
        "2",
        3
      ],
      "steps": [
        {
          "math": "6/√3 = 6√3/3",
          "reason": {
            "ar": "نضرب البسط والمقام في جذر ثلاثة.",
            "en": "Multiply both parts by the root of three."
          }
        },
        {
          "math": "6√3/3 = 2√3",
          "reason": {
            "ar": "نختزل المعامل، والقيمة محفوظة.",
            "en": "Reduce the coefficient, preserving the value."
          }
        }
      ],
      "check": {
        "expression": "6/3",
        "expected": "2"
      },
      "sourcePages": {
        "fromPdf": 16,
        "toPdf": 21
      }
    }
  ],
