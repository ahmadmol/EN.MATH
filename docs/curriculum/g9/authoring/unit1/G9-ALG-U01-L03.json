  "objectives": [
    {
      "ar": "أختزل كسرًا موجبًا دون تغيير قيمته وأبرر توقف الاختزال.",
      "en": "Reduce a positive fraction without changing its value and justify stopping."
    }
  ],
  "prerequisites": [
    {
      "ar": "القاسم المشترك الأكبر والكسور المتكافئة.",
      "en": "GCD and equivalent fractions."
    }
  ],
  "sections": [
    {
      "kind": "explanation",
      "title": {
        "ar": "قيمة واحدة وكتابات متعددة",
        "en": "One value, multiple forms"
      },
      "body": {
        "ar": "يمكن أن يمثل كسران القيمة نفسها. أبسط صورة تساعد على المقارنة، لكنها لا تغيّر القيمة.",
        "en": "Equivalent fractions have equal value. Simplest form helps comparison without changing that value."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "definition",
      "title": {
        "ar": "متى يكون الكسر مختزلًا؟",
        "en": "When is a fraction reduced?"
      },
      "body": {
        "ar": "يكون كسر من عددين صحيحين موجبين مختزلًا عندما يكون القاسم المشترك الأكبر للبسط والمقام واحدًا.",
        "en": "A positive-integer fraction is reduced when numerator and denominator have GCD one."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "formula",
      "title": {
        "ar": "اقسم الطرفين معًا",
        "en": "Divide both parts"
      },
      "body": {
        "ar": "نقسم البسط والمقام على القاسم المشترك الأكبر نفسه. طرح العدد نفسه من الطرفين لا يحافظ عمومًا على قيمة الكسر.",
        "en": "Divide numerator and denominator by the same GCD. Subtracting the same number from both parts does not generally preserve the fraction."
      },
      "math": "a/b = (a/g)/(b/g); g = gcd(a,b)",
      "conditions": [
        {
          "ar": "البسط والمقام صحيحان موجبان؛ القاسم المشترك الأكبر موجب.",
          "en": "Positive integer numerator and denominator; positive GCD."
        }
      ]
    },
    {
      "kind": "summary",
      "title": {
        "ar": "افحص القيمة وأبسط صورة",
        "en": "Check value and simplest form"
      },
      "body": {
        "ar": "تحقق بالضرب التبادلي من تساوي القيمتين، ثم تحقق أن القاسم الجديد واحد. قد يكون الكسر مختزلًا منذ البداية.",
        "en": "Use cross multiplication to check equality, then verify GCD one. A fraction may already be reduced."
      },
      "math": "",
      "conditions": []
    }
  ],
  "examples": [
    {
      "id": "fraction-e0",
      "prompt": {
        "ar": "اختزل 36/84.",
        "en": "Reduce 36/84."
      },
      "verification": {
        "operation": "reduced_fraction",
        "numerator": 36,
        "denominator": 84
      },
      "verifiedResult": "3/7",
      "steps": [
        {
          "math": "gcd(36,84) = 12",
          "reason": {
            "ar": "أوجد أكبر قاسم مشترك.",
            "en": "Find the greatest common divisor."
          }
        },
        {
          "math": "36/84 = 3/7",
          "reason": {
            "ar": "اقسم البسط والمقام عليه. الطرفان الجديدان أوليان فيما بينهما.",
            "en": "Divide both parts by it; the new parts are coprime."
          }
        }
      ],
      "check": {
        "expression": "36/84",
        "expected": "3/7"
      },
      "sourcePages": {
        "fromPdf": 14,
        "toPdf": 15
      }
    },
