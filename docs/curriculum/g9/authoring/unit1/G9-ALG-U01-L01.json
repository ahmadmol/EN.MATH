  "objectives": [
    {
      "ar": "أميّز العدد الصحيح والعدد العادي والعدد العشري والعدد غير العادي.",
      "en": "Distinguish integers, rational, terminating-decimal and irrational numbers."
    },
    {
      "ar": "أختبر انتهاء الكتابة العشرية بعد اختزال الكسر.",
      "en": "Test decimal termination after reducing the fraction."
    }
  ],
  "prerequisites": [
    {
      "ar": "قسمة الأعداد الصحيحة واختزال الكسور.",
      "en": "Integer division and equivalent fractions."
    }
  ],
  "sections": [
    {
      "kind": "explanation",
      "title": {
        "ar": "ابدأ من معنى العدد",
        "en": "Start with the value"
      },
      "body": {
        "ar": "قد تتغير كتابة العدد من كسر إلى كتابة عشرية دون أن تتغير قيمته. نبحث عن خصائص القيمة، لا عن شكل الكتابة فقط.",
        "en": "A fraction and its decimal notation can represent the same value. Classify the value, not just its written form."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "definition",
      "title": {
        "ar": "الأعداد العادية",
        "en": "Rational numbers"
      },
      "body": {
        "ar": "العدد العادي يمكن كتابته كحاصل قسمة عددين صحيحين، على ألا يكون المقام صفرًا. كل عدد صحيح عدد عادي، لأننا نستطيع وضعه فوق المقام واحد.",
        "en": "A rational number is a quotient of two integers with nonzero denominator. Every integer is rational because its denominator can be one."
      },
      "math": "a/b; a,b ∈ Z; b ≠ 0",
      "conditions": []
    },
    {
      "kind": "definition",
      "title": {
        "ar": "العشري وغير العادي",
        "en": "Terminating and irrational"
      },
      "body": {
        "ar": "العدد العشري له كتابة عشرية منتهية، ويمكن كتابته بمقام قوة للعدد عشرة. العدد العادي قد يكون دوريًا غير منتهٍ. العدد غير العادي لا يمكن كتابته ككسر من عددين صحيحين؛ التقريب العشري لا يحوّله إلى عدد عشري منتهٍ.",
        "en": "A terminating decimal has finitely many decimal places and a power-of-ten denominator. A rational can instead repeat indefinitely. An irrational is not an integer quotient; a finite approximation does not change that classification."
      },
      "math": "",
      "conditions": []
    },
    {
      "kind": "formula",
      "title": {
        "ar": "اختبار الانتهاء",
        "en": "Termination test"
      },
      "body": {
        "ar": "اختزل الكسر أولًا. تنتهي كتابته العشرية إذا لم يبقَ في المقام أي عامل أولي غير اثنين أو خمسة. هذا معيار مساعد نبرره بتحويل المقام إلى قوة للعشرة.",
        "en": "Reduce first. Its decimal terminates exactly when the denominator has no prime factors except two and five, because it can then be converted to a power of ten."
      },
      "math": "d = 2^m × 5^n",
      "conditions": [
        {
          "ar": "الكسر مختزل؛ المقام موجب؛ الأسّان صحيحان غير سالبين.",
          "en": "Reduced fraction; positive denominator; nonnegative integer exponents."
        }
      ]
    },
    {
      "kind": "summary",
      "title": {
        "ar": "كيف أصنّف؟",
        "en": "Classification steps"
      },
      "body": {
        "ar": "أختزل، وأفحص هل القيمة صحيحة؛ إن لم تكن صحيحة أختبر انتهاء الكتابة العشرية. الكسور الباقية عادية دورية. لا أستنتج أن جذرًا غير عادي من شكله وحده: جذر المربع الكامل صحيح.",
        "en": "Reduce, test for an integer, then test termination. Remaining rational fractions recur. A radical is not automatically irrational: a perfect-square root is an integer."
      },
      "math": "",
      "conditions": []
    }
  ],
  "examples": [
    {
      "id": "nature-e1",
      "prompt": {
        "ar": "صنّف الكسر السالب.",
        "en": "Classify the negative fraction."
      },
      "verification": {
        "operation": "classification",
        "numerator": -18,
        "denominator": 8
      },
      "verifiedResult": "terminating",
      "steps": [
        {
          "math": "-18/8 = -9/4",
          "reason": {
            "ar": "نقسم الطرفين على اثنين.",
            "en": "Divide both parts by two."
          }
        },
        {
          "math": "-9/4 = -225/100 = -2.25",
          "reason": {
            "ar": "المقام أربعة؛ نحوله إلى مئة. القيمة عشرية غير صحيحة.",
            "en": "Convert denominator four to one hundred: a terminating noninteger."
          }
        }
      ],
      "check": {
        "expression": "-18/8",
        "expected": "-9/4"
      },
      "sourcePages": {
        "fromPdf": 6,
        "toPdf": 7
      }
    },
    {
      "id": "nature-e2",
      "prompt": {
        "ar": "هل لهذا الكسر كتابة عشرية منتهية؟",
        "en": "Does this fraction terminate?"
      },
      "verification": {
        "operation": "classification",
        "numerator": 7,
        "denominator": 12
      },
      "verifiedResult": "recurring",
      "steps": [
        {
          "math": "gcd(7,12) = 1",
          "reason": {
            "ar": "الكسر مختزل.",
            "en": "The fraction is reduced."
          }
        },
        {
          "math": "12 = 2^2 × 3",
          "reason": {
            "ar": "يوجد العامل ثلاثة؛ إذن العدد عادي دوري وليس عشريًا منتهيًا.",
            "en": "Factor three remains, so this rational recurs."
          }
        }
      ],
      "check": {
        "expression": "7/12",
        "expected": "7/12"
      },
      "sourcePages": {
        "fromPdf": 6,
        "toPdf": 7
      }
    },
    {
      "id": "nature-e3",
      "prompt": {
        "ar": "هل كل جذر عدد غير عادي؟",
        "en": "Is every radical irrational?"
      },
      "verification": {
        "operation": "classification",
        "radicand": 81
      },
      "verifiedResult": "integer",
      "steps": [
        {
          "math": "9^2 = 81",
          "reason": {
            "ar": "نتعرف إلى مربع كامل.",
            "en": "Identify a perfect square."
          }
        },
        {
          "math": "√81 = 9",
          "reason": {
            "ar": "الجذر صحيح، وبالتالي عادي وعشري أيضًا.",
            "en": "The root is an integer, hence also rational and terminating."
          }
        }
      ],
      "check": {
        "expression": "9**2",
        "expected": "81"
      },
      "sourcePages": {
        "fromPdf": 6,
        "toPdf": 7
      }
    }
  ],
